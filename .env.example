# =============================================================================
# HR Automation Agent - Unified Configuration
# =============================================================================
# Copy this file to '.env' and fill in your credentials.
# This file should NEVER be committed to version control.
# =============================================================================

# --- OpenAI (for JD generation and sentiment analysis) ---
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Database ---
DB_HOST=127.0.0.1
DB_NAME=hr_db
DB_USER=hr_user
DB_PASSWORD=your_postgres_password
DB_PORT=5433
DATABASE_URL=postgresql://hr_user:hr_pass@postgres:5432/hr_db

# --- Email / Brevo ---
# Sign up at: https://www.brevo.com/ and get your API key
# Set to "true" only after verifying real Brevo credentials
EMAIL_SEND_ENABLED=false
EMAIL_SENDER_EMAIL=your-company-email@domain.com
EMAIL_SENDER_NAME=HR Recruitment Team
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=your-company-email@domain.com
BLOCKED_EMAIL_PATTERNS=qa@,staging@,dev@,test@,demo@

# --- SMTP (optional, Brevo is primary) ---
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SENDER_PASSWORD=your-app-password

# --- Meeting Links (alternative to Google Calendar auto-creation) ---
MICROSOFT_TEAMS_MEETING_LINK=https://teams.live.com/meet/your-meeting-id
ZOOM_MEETING_LINK=https://us05web.zoom.us/j/your-meeting-id

# --- Zoom API (optional, for video interviews) ---
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
ZOOM_ACCOUNT_ID=your-zoom-account-id

# --- Google Calendar Service ---
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret

# --- Razorpay ---
RAZORPAY_KEY_ID=placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret

# --- n8n ---
N8N_PORT=5678

# --- Frontend (Vite reads VITE_* vars automatically) ---
VITE_API_BASE_URL=http://localhost:8000

# --- OAuth Integration ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

