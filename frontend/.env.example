# --- OAuth Integration (Better Auth API routes only) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
BETTER_AUTH_JWT_SECRET=your-better-auth-jwt-secret-key-in-prod

# --- Firebase (login page Google/GitHub buttons use Firebase, not the vars above) ---
# Enable Google + GitHub in Firebase Console -> Authentication -> Sign-in method.
# For GitHub, use the same OAuth app's Client ID/Secret in Firebase's GitHub provider settings.
# Authorization callback URL shown in Firebase must be added to your GitHub OAuth app.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# --- Database ---
DATABASE_URL=postgresql://hr_user:hr_pass@postgres:5432/hr_db
