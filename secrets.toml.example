# =============================================================================
# HR Automation Agent - Configuration File
# =============================================================================
# Copy this file to 'secrets.toml' and fill in your credentials.
# This file should NEVER be committed to version control.
# =============================================================================

# --- OpenAI API Key (for JD generation and sentiment analysis) ---
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY = "sk-your-openai-api-key-here"

# --- PostgreSQL Database ---
# Your PostgreSQL database connection details
[database]
host = "localhost"
name = "resume_analyzer"
user = "postgres"
password = "your_postgres_password"
port = 5432

# --- Zoom Configuration (optional, for video interviews) ---
[zoom]
client_id = "your-zoom-client-id"
client_secret = "your-zoom-client-secret"
account_id = "your-zoom-account-id"

# --- Meeting Links (alternative to Google Calendar auto-creation) ---
[email.Microsoft_Teams]
meeting_link = "https://teams.live.com/meet/your-meeting-id"

[email.Zoom_Meeting]
meeting_link = "https://us05web.zoom.us/j/your-meeting-id"

# --- n8n Configuration (for workflow automation) ---
# These are used by the backend to communicate with n8n
# Update if n8n runs on a different host or port
[n8n]
base_url = "http://localhost:5678"
webhook_url = "http://localhost:5678/webhook/your-webhook-name"

# --- Brevo Email API (used by n8n workflows for sending emails) ---
# Sign up at: https://www.brevo.com/ and get your API key
[brevo]
api_key = "your-brevo-api-key"
sender_name = "HR Team"
sender_email = "your-company-email@domain.com"
